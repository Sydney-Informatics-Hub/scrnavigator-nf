nextflow_process {

    name "Test Process PREPROCESS_RDS"
    script "modules/preprocess_rds.nf"
    process "PREPROCESS_RDS"

    test("Should run without failures") {

        when {
            params {
                // define parameters here. Example:
                // outdir = "tests/results"
            }
            process {
                """
                input[0] = channel.of([
                    "sample_1_ctrl",
                    file("${projectDir}/tests/data/rds/sample_1.ctrl.Rds", checkIfExists: true),
                    [
                        condition: "ctrl"
                    ],
                    "human",
                    [],
                    true,
                    []
                ])
                """
            }
        }

        then {
            assert process.success
            assert snapshot(process.out).match()
        }

    }

}
