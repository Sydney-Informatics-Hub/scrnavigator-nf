nextflow_process {

    name "Test Process FILTER"
    script "modules/filter.nf"
    process "FILTER"

    test("Should run without failures") {

        when {
            params {
                // define parameters here. Example:
                // outdir = "tests/results"
            }
            process {
                """
                input[0] = channel.of([
                    "sample_1_ctrl",
                    file("${projectDir}/tests/data/rds/sample_1_ctrl.preprocessed.rds", checkIfExists: true),
                    [
                        res: 1,
                        min_ncount: 0,
                        max_ncount: null,
                        min_nfeature: 0,
                        max_nfeature: null,
                        min_mt_pct: 0,
                        max_mt_pct: 1
                    ],
                    []
                ])
                """
            }
        }

        then {
            assert process.success
            assert snapshot(process.out).match()
        }

    }

}
