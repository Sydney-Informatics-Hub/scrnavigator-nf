nextflow_process {

    name "Test Process DETECT_DOUBLETS"
    script "modules/doublet.nf"
    process "DETECT_DOUBLETS"

    test("Should run without failures") {

        when {
            params {
                // define parameters here. Example:
                // outdir = "tests/results"
            }
            process {
                """
                input[0] = channel.of([
                    "sample_1_ctrl",
                    file("${projectDir}/tests/data/rds/sample_1_ctrl.sct_clustered.rds", checkIfExists: true),
                    "",
                    "0.8",
                    "0.8,1.0,1.2,1.4",
                    "leiden"
                ])
                """
            }
        }

        then {
            assert process.success
        }

    }

}
