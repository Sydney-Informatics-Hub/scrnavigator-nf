nextflow_process {

    name "Test Process ANNOTATE_CUSTOM"
    script "modules/annotate_custom.nf"
    process "ANNOTATE_CUSTOM"

    test("human: null ens_db") {

        when {
            process {
                """
                input[0] = channel.of([
                    "cohort",
                    file("${projectDir}/tests/data/rds/cohort.integrated.clustered.test.rds", checkIfExists: true),
                    "human",
                    [],
                    file("${projectDir}/tests/data/custom_markers.csv", checkIfExists: true),
                    1
                ])
                """
            }
        }

        then {
            assert process.success
            assert snapshot(
                process.out.available_annotations,
                process.out.annotated_rds.collect { it[0] }
            ).match()
        }

    }

    test("human: ens_db provided and used") {

        when {
            process {
                """
                input[0] = channel.of([
                    "cohort",
                    file("${projectDir}/tests/data/rds/cohort.integrated.clustered.test.rds", checkIfExists: true),
                    "human",
                    file("${projectDir}/tests/data/EnsDb_hsapiens_v113.sqlite", checkIfExists: true),
                    file("${projectDir}/tests/data/custom_markers.csv", checkIfExists: true),
                    1
                ])
                """
            }
        }

        then {
            assert process.success
            assert snapshot(
                process.out.available_annotations,
                process.out.annotated_rds.collect { it[0] }
            ).match()
        }

    }

}
