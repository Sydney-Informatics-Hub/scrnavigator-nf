nextflow_process {

    name "Test Process ANNOTATE_CELL_CYCLE"
    script "modules/annotate_cell_cycle.nf"
    process "ANNOTATE_CELL_CYCLE"

    test("human: null ens_db uses built-in EnsDb") {

        when {
            process {
                """
                input[0] = channel.of([
                    "cohort",
                    file("${projectDir}/tests/data/rds/cohort.integrated.test.rds", checkIfExists: true),
                    "human",
                    [],
                    [],
                    []
                ])
                """
            }
        }

        then {
            assert process.success
            assert snapshot(
                process.out.available_annotations,
                process.out.annotated_rds.collect { it[0] }
            ).match()
        }

    }

    test("human: ens_db provided and used") {

        when {
            process {
                """
                input[0] = channel.of([
                    "cohort",
                    file("${projectDir}/tests/data/rds/cohort.integrated.test.rds", checkIfExists: true),
                    "human",
                    [],
                    [],
                    file("${projectDir}/tests/data/EnsDb_hsapiens_v113.sqlite", checkIfExists: true)
                ])
                """
            }
        }

        then {
            assert process.success
            assert snapshot(
                process.out.available_annotations,
                process.out.annotated_rds.collect { it[0] }
            ).match()
        }

    }

}
