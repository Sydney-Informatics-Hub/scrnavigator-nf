nextflow_process {

    name "Test Process SCTRANSFORM"
    script "modules/sct.nf"
    process "SCTRANSFORM"

    test("Should run without failures") {

        when {
            params {
                // define parameters here. Example:
                // outdir = "tests/results"
            }
            process {
                """
                input[0] = channel.of([
                    "sample_1_ctrl",
                    file("${projectDir}/tests/data/rds/sample_1_ctrl.preprocessed.rds", checkIfExists: true),
                    "",
                    "0.8,1.0,1.2,1.4",
                    "leiden"
                ])
                """
            }
        }

        then {
            assert process.success
            assert snapshot(process.out.qc_results).match()
        }

    }

}
